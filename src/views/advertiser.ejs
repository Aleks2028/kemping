<%- include('partials/header') %>

<div class="advertiser-page">
  <div class="page-header">
    <h1>📊 Кабинет рекламодателя</h1>
    <div class="header-actions">
      <a href="/advertiser/deposit" class="btn btn-primary">💰 Пополнить баланс</a>
      <a href="/advertiser/new-task" class="btn btn-ghost">➕ Создать задание</a>
    </div>
  </div>

  <!-- VIP-баннеры -->
  <div id="vip-banners" class="vip-banners-bar" style="display:none; margin-bottom: 24px;"></div>

  <div id="onboarding" class="onboarding" style="display:none;">
    <div class="onboarding-card">
      <h2>Станьте рекламодателем</h2>
      <p>Создавайте задания и привлекайте реальную аудиторию. Подписки, регистрации, лайки — всё под вашим контролем.</p>
      <form id="become-form">
        <div class="form-group">
          <label>Название компании / проекта</label>
          <input type="text" name="companyName" required placeholder="Мой крутой проект" />
        </div>
        <div class="form-group">
          <label>Контакт (email или Telegram)</label>
          <input type="text" name="contact" required placeholder="@username или email@site.com" />
        </div>
        <button type="submit" class="btn btn-primary">Стать рекламодателем</button>
      </form>
    </div>
  </div>

  <div id="dashboard" style="display:none;">
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label-sm">Баланс</div>
        <div class="stat-big" id="adv-balance">—</div>
        <a href="/advertiser/deposit" class="btn btn-primary btn-sm">Пополнить</a>
      </div>
      <div class="stat-card">
        <div class="stat-label-sm">Всего потрачено</div>
        <div class="stat-big" id="adv-spent">—</div>
      </div>
      <div class="stat-card">
        <div class="stat-label-sm">Активных заданий</div>
        <div class="stat-big" id="adv-active">—</div>
      </div>
      <div class="stat-card">
        <div class="stat-label-sm">Выполнений одобрено</div>
        <div class="stat-big" id="adv-approved">—</div>
      </div>
    </div>

    <!-- Продвижение -->
    <div class="promo-grid">
      <a href="/advertiser/referrals" class="promo-card">
        <div class="promo-icon">👥</div>
        <div class="promo-content">
          <h3>Купить рефералов</h3>
          <p>Обычные и VIP-рефералы для вашего аккаунта</p>
        </div>
        <div class="promo-arrow">→</div>
      </a>
      <a href="/advertiser/vip" class="promo-card promo-card-vip">
        <div class="promo-icon">👑</div>
        <div class="promo-content">
          <h3>VIP-реклама</h3>
          <p>Баннеры, закрепления, бейджи и показы</p>
        </div>
        <div class="promo-arrow">→</div>
      </a>
    </div>

    <div class="section-header">
      <h2>Мои задания</h2>
      <a href="/advertiser/new-task" class="btn btn-primary btn-sm">➕ Новое задание</a>
    </div>

    <div id="my-tasks">
      <div class="loading">Загружаем…</div>
    </div>
  </div>
</div>

<script>
async function load() {
  const res = await fetch('/api/advertiser/me', {
    headers: { 'Authorization': 'Bearer ' + localStorage.getItem('token') }
  });
  const data = await res.json();

  if (!data.isAdvertiser) {
    document.getElementById('onboarding').style.display = 'block';
    document.getElementById('dashboard').style.display = 'none';
    return;
  }

  document.getElementById('onboarding').style.display = 'none';
  document.getElementById('dashboard').style.display = 'block';

  const a = data.advertiser;
  const s = data.stats;
  document.getElementById('adv-balance').textContent = '$' + (a.balance / 100).toFixed(2);
  document.getElementById('adv-spent').textContent = '$' + (a.total_spent / 100).toFixed(2);
  document.getElementById('adv-active').textContent = s.activeTasks;
  document.getElementById('adv-approved').textContent = s.approvedCompletions;

  loadTasks();
  loadVipBanners();
}

async function loadVipBanners() {
  const res = await fetch('/api/vip/banners');
  const { banners } = await res.json();
  if (banners.length === 0) return;
  const bar = document.getElementById('vip-banners');
  bar.style.display = 'flex';
  bar.innerHTML = banners.map(b => `
    <a href="${b.link}" target="_blank" class="vip-banner-mini" style="background:${b.color};">
      <span>🏆 ${escapeHtml(b.title)}</span>
    </a>
  `).join('');
}
function escapeHtml(s) {
  const div = document.createElement('div');
  div.textContent = s;
  return div.innerHTML;
}

async function loadTasks() {
  const res = await fetch('/api/advertiser/tasks', {
    headers: { 'Authorization': 'Bearer ' + localStorage.getItem('token') }
  });
  const { tasks } = await res.json();
  const el = document.getElementById('my-tasks');

  if (tasks.length === 0) {
    el.innerHTML = '<p class="empty">У вас пока нет заданий. <a href="/advertiser/new-task">Создайте первое →</a></p>';
    return;
  }

  el.innerHTML = tasks.map(t => `
    <div class="task-card">
      <div class="task-header">
        <span class="task-type task-type-${t.type}">${getTypeLabel(t.type)}</span>
        <span class="task-status-badge ${t.status}">${statusLabel(t.status)}</span>
      </div>
      <h3>${t.title}</h3>
      <div class="task-meta">
        <span>💰 Награда: <strong>$${(t.userReward / 100).toFixed(2)}</strong></span>
        <span>👥 ${t.totalSlots - t.remainingSlots} / ${t.totalSlots} выполнено</span>
        <span>Осталось: <strong>${t.remainingSlots}</strong></span>
      </div>
      <div class="task-actions">
        ${t.status === 'active' ? `<button class="btn btn-ghost btn-sm" onclick="pauseTask('${t.id}')">⏸ Пауза</button>` : ''}
        <a href="${t.url}" target="_blank" class="btn btn-ghost btn-sm">🔗 Ссылка</a>
      </div>
    </div>
  `).join('');
}

function getTypeLabel(type) {
  return { subscribe:'Подписка', register:'Регистрация', like:'Лайк', view:'Просмотр', custom:'Задание' }[type] ?? 'Задание';
}
function statusLabel(s) {
  return { active:'Активно', paused:'На паузе', finished:'Завершено', pending_review:'На модерации' }[s] ?? s;
}
async function pauseTask(id) {
  await fetch('/api/advertiser/tasks/' + id + '/pause', {
    method: 'POST',
    headers: { 'Authorization': 'Bearer ' + localStorage.getItem('token') }
  });
  loadTasks();
}

document.getElementById('become-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(e.target));
  const res = await fetch('/api/advertiser/register', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + localStorage.getItem('token') },
    body: JSON.stringify(data),
  });
  const json = await res.json();
  if (res.ok) {
    load();
  } else {
    alert(json.error || 'Ошибка');
  }
});

load();
</script>

<style>
.header-actions { display: flex; gap: 8px; flex-wrap: wrap; }
.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 40px; }
.stat-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; text-align: center; }
.stat-label-sm { color: var(--text-dim); font-size: 13px; margin-bottom: 8px; }
.stat-big { font-size: 28px; font-weight: 800; color: var(--primary); margin-bottom: 12px; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
.section-header h2 { color: var(--text-bright); }
.onboarding-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 40px; max-width: 500px; margin: 40px auto; }
.onboarding-card h2 { color: var(--text-bright); margin-bottom: 12px; }
.onboarding-card p { color: var(--text-dim); margin-bottom: 24px; }
.onboarding-card .form-group { margin-bottom: 16px; }
.task-status-badge { font-size: 12px; padding: 3px 8px; border-radius: 999px; font-weight: 600; }
.task-status-badge.active { background: rgba(16,185,129,.2); color: #86efac; }
.task-status-badge.paused { background: rgba(245,158,11,.2); color: #fcd34d; }
.task-status-badge.finished { background: rgba(156,163,175,.2); color: #d1d5db; }
.task-status-badge.pending_review { background: rgba(59,130,246,.2); color: #93c5fd; }
.task-actions { display: flex; gap: 8px; margin-top: 12px; }
.vip-banners-bar { display: flex; gap: 12px; overflow-x: auto; }
.vip-banner-mini { flex-shrink: 0; padding: 10px 20px; border-radius: 999px; color: white; text-decoration: none; font-weight: 700; font-size: 14px; box-shadow: 0 4px 12px rgba(0,0,0,.2); transition: transform .2s; }
.vip-banner-mini:hover { transform: scale(1.05); }
.promo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 32px; }
.promo-card { display: flex; align-items: center; gap: 16px; background: white; border: 2px solid rgba(168,85,247,.1); border-radius: var(--radius); padding: 24px; text-decoration: none; transition: all .3s; }
.promo-card:hover { border-color: var(--primary); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(168,85,247,.15); }
.promo-card-vip { background: linear-gradient(135deg, #fffbeb, #fef3c7); border-color: rgba(251,191,36,.4); }
.promo-card-vip:hover { border-color: #f59e0b; box-shadow: 0 8px 24px rgba(251,191,36,.2); }
.promo-icon { font-size: 40px; flex-shrink: 0; }
.promo-content h3 { font-size: 18px; color: var(--text-bright); margin-bottom: 4px; }
.promo-content p { font-size: 13px; color: var(--text-dim); }
.promo-arrow { font-size: 24px; color: var(--text-dim); margin-left: auto; flex-shrink: 0; }
@media (max-width: 600px) { .promo-grid { grid-template-columns: 1fr; } }
</style>

<%- include('partials/footer') %>
