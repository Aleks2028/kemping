# ─── App ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Auth ──────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=./data/earn2surf.db

# ─── Admin ────────────────────────────────────────────────
# Telegram ID(s) of admins, comma-separated
ADMIN_TELEGRAM_IDS=111111,222222

# ─── Payout ────────────────────────────────────────────────
# Minimum withdrawal amount in cents (1.00 = 100)
MIN_WITHDRAWAL_USD=5

# ─── USDT (TRC20) ─────────────────────────────────────────
# Telegram bot token for payment notifications (optional)
# PAYMENT_BOT_TOKEN=

# ─── ЮMoney ────────────────────────────────────────────────
# YOOMONEY_WALLET=your_wallet_number
# YOOMONEY_TOKEN=your_oauth_token

# ─── Balance ───────────────────────────────────────────────
# How much advertiser pays per completed task (in cents)
# Platform keeps the rest as commission
PLATFORM_FEE_PERCENT=20

# ─── Referral ──────────────────────────────────────────────
REFERRAL_BONUS_PERCENT=10
