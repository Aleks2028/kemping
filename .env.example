# ─── App ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Auth ──────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=./data/earn2surf.db

# ─── Admin ────────────────────────────────────────────────
# Telegram ID(s) of admins, comma-separated
ADMIN_TELEGRAM_IDS=111111,222222

# ─── Payout ────────────────────────────────────────────────
# Minimum withdrawal amount in cents (1.00 = 100)
MIN_WITHDRAWAL_USD=10

# ─── Platform fee ──────────────────────────────────────────
PLATFORM_FEE_PERCENT=70
REFERRAL_BONUS_PERCENT=10

# ─── USDT TRC20 ────────────────────────────────────────────
# TronGrid API key (https://trongrid.io) — для приёма USDT TRC20
TRONGRID_API_KEY=
USDT_TRC20_WALLET=YOUR_TRC20_WALLET_HERE

# ─── BTC ───────────────────────────────────────────────────
BTC_ADDRESS=YOUR_BTC_ADDRESS_HERE
BTC_FEE_PERCENT=2

# ─── ETH / ERC20 ───────────────────────────────────────────
ETH_ADDRESS=YOUR_ETH_ADDRESS_HERE
ETH_FEE_PERCENT=2

# ─── TON / SOL / BNB ───────────────────────────────────────
TON_ADDRESS=YOUR_TON_ADDRESS_HERE
SOL_ADDRESS=YOUR_SOL_ADDRESS_HERE
BNB_ADDRESS=YOUR_BNB_ADDRESS_HERE

# ─── ЮMoney ────────────────────────────────────────────────
YOOMONEY_WALLET=4100111111111111
YOOMONEY_NOTIFICATION_SECRET=your_secret_here

# ─── ЮKassa (YooKassa) — для банковских карт ──────────────
# Получить на https://yookassa.ru
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://kemping.ru/advertiser

# ─── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
